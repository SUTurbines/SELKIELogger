                            <label>Source Name:</label>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>1</option>
                        <border>2</border>
                        <flag>wxALL|wxEXPAND</flag>
                        <object class="wxTextCtrl" name="name" base="EditTextCtrl">
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL|wxEXPAND|wxALIGN_CENTER_VERTICAL</flag>
                        <object class="wxStaticText" name="_ctSourceNumber" base="EditStaticText">
                            <label>Source Number:\nDefault range: 96...110</label>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL</flag>
                        <object class="wxSpinCtrl" name="sourcenum" base="EditSpinCtrl">
                            <style>wxSP_ARROW_KEYS</style>
                            <range>0, 120</range>
                            <value>96</value>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL|wxEXPAND|wxALIGN_CENTER_VERTICAL</flag>
                        <object class="wxStaticText" name="_ctPort" base="EditStaticText">
                            <label>Port:</label>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>1</option>
                        <border>2</border>
                        <flag>wxALL|wxEXPAND</flag>
                        <object class="wxTextCtrl" name="port" base="EditTextCtrl">
                            <tooltip>e.g. /dev/ttyUSB0, /dev/serial/by-id/xxxxxx</tooltip>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL</flag>
                        <object class="wxStaticText" name="_ctBaud" base="EditStaticText">
                            <label>Baud rate:</label>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL|wxEXPAND</flag>
                        <object class="wxTextCtrl" name="baud" base="EditTextCtrl">
                            <value>115200</value>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL</flag>
                        <object class="wxStaticText" name="_ctPSize" base="EditStaticText">
                            <label>Packet size range:</label>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>1</option>
                        <border>1</border>
                        <flag>wxALL|wxEXPAND</flag>
                        <object class="wxBoxSizer" name="psizes" base="EditBoxSizer">
                            <orient>wxHORIZONTAL</orient>
                            <object class="sizeritem">
                                <option>0</option>
                                <border>2</border>
                                <flag>wxALL</flag>
                                <object class="wxSpinCtrl" name="minpacketsize" base="EditSpinCtrl">
                                    <size>160, -1</size>
                                    <style>wxSP_ARROW_KEYS</style>
                                    <range>0, 1024</range>
                                    <value>10</value>
                                </object>
                            </object>
                            <object class="sizeritem">
                                <option>0</option>
                                <border>5</border>
                                <flag>wxALL|wxALIGN_CENTER_VERTICAL</flag>
                                <object class="wxStaticText" name="_ctTo" base="EditStaticText">
                                    <label>to</label>
                                </object>
                            </object>
                            <object class="sizeritem">
                                <option>0</option>
                                <border>2</border>
                                <flag>wxALL</flag>
                                <object class="wxSpinCtrl" name="maxpacketsize" base="EditSpinCtrl">
                                    <size>160, -1</size>
                                    <style>wxSP_ARROW_KEYS</style>
                                    <range>0, 1024</range>
                                    <value>100</value>
                                </object>
                            </object>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL</flag>
                        <object class="wxStaticText" name="_ctFreq" base="EditStaticText">
                            <label>Frequency</label>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL</flag>
                        <object class="wxSpinCtrl" name="frequency" base="EditSpinCtrl">
                            <style>wxSP_ARROW_KEYS</style>
                            <range>0, 20</range>
                            <value>10</value>
                        </object>
                    </object>
                    <object class="sizerslot" />
                    <object class="sizerslot" />
                </object>
            </object>
            <object class="sizeritem">
                <option>0</option>
                <border>4</border>
                <flag>wxALL|wxALIGN_RIGHT</flag>
                <object class="wxStdDialogButtonSizer" name="sizer_2" base="EditStdDialogButtonSizer">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>0</border>
                        <object class="wxButton" name="button_OK" base="EditButton">
                            <label>OK</label>
                            <default>1</default>
                            <stockitem>OK</stockitem>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>0</border>
                        <object class="wxButton" name="button_CANCEL" base="EditButton">
                            <label>Cancel</label>
                            <stockitem>CANCEL</stockitem>
                        </object>
                    </object>
                </object>
            </object>
        </object>
    </object>
</application>
