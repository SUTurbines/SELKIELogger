    <object class="SLCGeneric" name="SLCGeneric" base="EditDialog">
        <extracode>from SELKIELogger.Config import SLCUnknown</extracode>
        <extracode_post>self.generateSource = lambda: SLCUnknown(tag=self.tag.GetValue(), sourcetype=self.type.GetValue(), params=self.parameters.GetValue().split("\\n"))\ndef updateFromSource(s):\n    self.tag.SetValue(s.tag)\n    self.type.SetValue(s.sourcetype)\n    self.parameters.SetValue("\\n".join(s.params))\n\nself.updateFromSource = updateFromSource</extracode_post>
        <size>400, 450</size>
