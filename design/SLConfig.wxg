    <object class="SLCMPConfig" name="SLCMPConfig" base="EditDialog">
        <extracode>from SELKIELogger.Config import SLCMP</extracode>
        <extracode_post>self.generateSource = lambda: SLCMP(tag=self.tag.GetValue(), port=self.port.GetValue(), baud=int(self.baud.GetValue()))\ndef updateFromSource(s):\n    self.tag.SetValue(s.tag)\n    self.port.SetValue(s.port)\n    self.baud.SetValue(str(s.baud))\n\nself.updateFromSource = updateFromSource</extracode_post>
        <size>400, 330</size>
