    <object class="SLCChooseType" name="SLCChooseType" base="EditDialog">
        <extracode>from SELKIELogger.Config import SourceTypes</extracode>
        <extracode_post>sources = []\nfor st in SourceTypes:\n    if SourceTypes[st][2]:\n        # SourceTypes[x][2] is the "show by default" flag\n        # Hidden types are still recognised and handled, but won't be\n        # offered to the user in this dialog\n        caption = f"{st}: {SourceTypes[st][1]}"\n        sources.extend([caption])\nself.ctType.Append(sources)</extracode_post>
        <title>SLConfig: Source Type</title>
        <style>wxDEFAULT_DIALOG_STYLE</style>
        <affirmative>btnCTOK</affirmative>
        <escape>btnCTCancel</escape>
        <centered>1</centered>
        <object class="wxBoxSizer" name="_ct" base="EditBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
