        <title>SLConfig: Source Type</title>
        <style>wxDEFAULT_DIALOG_STYLE</style>
        <affirmative>btnCTOK</affirmative>
        <escape>btnCTCancel</escape>
        <centered>1</centered>
        <object class="wxBoxSizer" name="_ct" base="EditBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
                <option>1</option>
                <border>0</border>
                <flag>wxEXPAND</flag>
                <object class="wxStaticBoxSizer" name="sizer_2" base="EditStaticBoxSizer">
                    <orient>wxVERTICAL</orient>
                    <label>Source Type</label>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL</flag>
                        <object class="wxStaticText" name="label_1" base="EditStaticText">
                            <label>Select data source type:</label>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>0</option>
                        <border>2</border>
                        <flag>wxALL|wxEXPAND</flag>
                        <object class="wxComboBox" name="ctType" base="EditComboBox">
                            <style>wxCB_DROPDOWN|wxCB_SORT</style>
                            <selection>-1</selection>
                            <choices>
                                <choice>DW: Datawell Wave Buoy</choice>
                                <choice>GPS: uBlox GPS Module (or compatible)</choice>
                                <choice>I2C: I2C connected sensors</choice>
                                <choice>NMEA: Classic NMEA serial interface</choice>
                                <choice>N2K: Actisense NMEA 2000 USB Gateway (or compatble)</choice>
                                <choice>SL: Hardware outputting SELKIELogger formatted messages</choice>
                                <choice>SERIAL: Generic serial device support (record only)</choice>
                                <choice>TCP: Generic TCP network data source (record only)</choice>
                                <choice>TIMER: Software defined timestamp generator</choice>
                                <choice>LPMS: LP Research IMU devices</choice>
                                <choice>MQTT: Subscribe to MQTT network broker (inc. Victron devices)</choice>
                            </choices>
                        </object>
                    </object>
                    <object class="sizeritem">
                        <option>2</option>
                        <border>2</border>
                        <flag>wxALL</flag>
                        <object class="wxStaticText" name="lblDescription" base="EditStaticText">
