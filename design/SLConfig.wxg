    <object class="SLCSerialConfig" name="SLCSerialConfig" base="EditDialog">
        <extracode>from SELKIELogger.Config import SLCSerial</extracode>
        <extracode_post>self.generateSource = lambda: SLCSerial(tag=self.tag.GetValue(), port=self.port.GetValue(), baud=int(self.baud.GetValue()), name=self.name.GetValue(), sourcenum=self.sourcenum.GetValue(), minbytes=self.minpacketsize.GetValue(), maxbytes=self.maxpacketsize.GetValue(), frequency=self.frequency.GetValue())\n</extracode_post>
