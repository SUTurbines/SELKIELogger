        <extracode_post>self.sourcenum.SetBase(16)\nself.sourcenum.SetValue(0x60)\nself.timeout.SetValue(180)\n\nself.generateSource = lambda: SLCDW(tag=self.tag.GetValue(), timeout=int(self.timeout.GetValue()), host=self.host.GetValue(), name=self.name.GetValue(), sourcenum=self.sourcenum.GetValue(), spectrum=self.spectrum.GetValue(), raw=self.raw.GetValue())\ndef updateFromSource(s):\n    self.tag.SetValue(s.tag)\n    self.timeout.SetValue(str(s.timeout))\n    self.host.SetValue(s.host)\n    self.name.SetValue(s.name)\n    self.sourcenum.SetValue(s.sourcenum)\n    self.spectrum.SetValue(s.spectrum)\n    self.raw.SetValue(s.raw)\n\nself.updateFromSource = updateFromSource</extracode_post>
